# Cross-compiling the native core for Windows x64 with llvm-mingw (docs/native.md "Windows"): clang targeting
# x86_64-w64-mingw32 (the UCRT runtime), lld, libc++. LLVM_MINGW: the unpacked release folder (default local/vendor/llvm-mingw).
#   cmake -S . -B build/native-win64 -G Ninja -DCMAKE_TOOLCHAIN_FILE=native/cmake/llvm-mingw-x86_64.cmake
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT LLVM_MINGW)
    if(DEFINED ENV{LLVM_MINGW})
        set(LLVM_MINGW "$ENV{LLVM_MINGW}")
    else()
        get_filename_component(LLVM_MINGW "${CMAKE_CURRENT_LIST_DIR}/../../local/vendor/llvm-mingw" ABSOLUTE)
    endif()
endif()
set(LLVM_MINGW "${LLVM_MINGW}" CACHE PATH "The llvm-mingw toolchain folder")
set(CMAKE_C_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${LLVM_MINGW}/bin/x86_64-w64-mingw32-windres")
set(CMAKE_AR "${LLVM_MINGW}/bin/llvm-ar")
set(CMAKE_RANLIB "${LLVM_MINGW}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
# standalone executables: libc++, libunwind and the compiler runtime linked in (no DLLs next to the .exe)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static")
