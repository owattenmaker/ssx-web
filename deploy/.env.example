# Deploy configuration (docs/hosting.md "Deploy configuration"). Copy to deploy/.env.local (git-ignored) and fill in.
# deploy/env.sh reads it; a variable set in the environment wins over this file. `sh deploy/env.sh` shows the result.

# ssh target of the host (user@host), used by deploy/deploy-staged.sh and deploy/deploy.sh
SSX_HOST=user@host.example
# the host's folder for the game, relative to that user's home: ~/<SSX_HOST_ROOT>/app/web, etc, state, logs
SSX_HOST_ROOT=ssx-host
# launchd label prefix of the two agents: <SSX_LABEL>.server and <SSX_LABEL>.tunnel
SSX_LABEL=com.example.ssx

# Also local-only, made from their templates (see docs/hosting.md):
#   deploy/wrangler.toml             from deploy/wrangler.toml.example (the site's route and zone)
#   deploy/<SSX_LABEL>.server.plist  from deploy/ssx.server.plist.example (label, host folder, the site's origin)
#   deploy/<SSX_LABEL>.tunnel.plist  from deploy/ssx.tunnel.plist.example
